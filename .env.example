# Google Cloud Console > APIs & Services > Credentials 에서 발급.
# Maps JavaScript API를 활성화한 브라우저 키를 사용하세요.
VITE_GOOGLE_MAPS_API_KEY=

# (선택) Google Cloud Console > Google Maps Platform > Map Management 에서 발급한 Map ID.
# 비워두면 Google 공개 데모 Map ID(DEMO_MAP_ID)로 동작하지만, 커스텀 지도 스타일을 쓰려면
# 직접 발급받은 Map ID를 넣어주세요.
VITE_GOOGLE_MAPS_MAP_ID=

# /admin 진입은 이제 Supabase Auth 로그인 + mimo_users.is_admin 플래그로 관리됩니다.
# 관리자로 만들 계정은 가입 후 SQL로 `update mimo_users set is_admin = true where uid = '...'` 실행하세요.
